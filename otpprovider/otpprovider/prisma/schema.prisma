// OTPProvider — Core Database Schema
// Designed for PostgreSQL / Neon. Extend freely — this covers the core
// systems (auth, RBAC, wallet, providers, payments, news, contact) as fully
// working models, plus a wide set of business-domain models (CRM, support,
// marketing, diagnostics, audit) scaffolded so the app can grow into the
// full spec without re-architecting the database later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ AUTH / RBAC ============

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?
  name          String
  status        UserStatus   @default(ACTIVE)
  emailVerified DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean   @default(false)
  locale        String       @default("en")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  roles         UserRole[]
  customer      Customer?
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  newsPosts     NewsPost[]   @relation("NewsAuthor")
  approvedNews  NewsPost[]   @relation("NewsApprover")
  tickets       Ticket[]     @relation("TicketAgent")
  walletTx      WalletTransaction[] @relation("TxActor")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // SUPER_ADMIN, ADMIN, SUPPORT, SALES, MARKETING, FINANCE, DEVELOPER, OPERATIONS, CLIENT
  name        String
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique // e.g. users.view, wallet.adjust
  group String // e.g. users, wallet, providers

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ============ CUSTOMER / MULTI-TENANCY ============

model Customer {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String?
  country    String?
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime @default(now())

  wallet      Wallet?
  apiKeys     ApiKey[]
  messages    Message[]
  tickets     Ticket[]
  invoices    Invoice[]
}

// ============ WALLET (LEDGER) ============

enum WalletTxType {
  DEPOSIT
  CHARGE
  REFUND
  CREDIT
  ADJUSTMENT
}

model Wallet {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance    Decimal  @default(0) @db.Decimal(14, 4)
  currency   String   @default("USD")
  updatedAt  DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id         String       @id @default(cuid())
  walletId   String
  wallet     Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type       WalletTxType
  amount     Decimal      @db.Decimal(14, 4)
  balanceAfter Decimal    @db.Decimal(14, 4)
  reference  String?      // e.g. paymentGatewayId, invoiceId, messageId
  note       String?
  actorId    String?
  actor      User?        @relation("TxActor", fields: [actorId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([walletId])
}

// ============ PAYMENT GATEWAYS (GENERIC, ADMIN-TOGGLED) ============

enum GatewayMode {
  SANDBOX
  LIVE
}

model PaymentGateway {
  id          String   @id @default(cuid())
  key         String   @unique // admin-defined slug, e.g. "stripe", "paymob", "bank_transfer"
  displayName String
  enabled     Boolean  @default(false)
  mode        GatewayMode @default(SANDBOX)
  // Encrypted JSON blob of gateway-specific config (API keys, webhook secrets...)
  // Encrypted at the application layer before it ever reaches the DB — see lib/encryption.ts
  configEncrypted String?
  countries   String[] // ISO country codes this gateway is available for; empty = all
  currencies  String[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id         String        @id @default(cuid())
  gatewayId  String
  gateway    PaymentGateway @relation(fields: [gatewayId], references: [id])
  customerId String
  amount     Decimal       @db.Decimal(14, 4)
  currency   String
  status     PaymentStatus @default(PENDING)
  externalRef String?
  rawPayload  Json?
  createdAt  DateTime      @default(now())
}

// ============ COMMUNICATION PROVIDERS (SMS/OTP/VOICE/WHATSAPP/EMAIL) ============

enum ProviderKind {
  TWILIO
  VONAGE
  TELNYX
  PLIVO
  OTHER
}

model Provider {
  id          String       @id @default(cuid())
  kind        ProviderKind
  name        String
  enabled     Boolean      @default(false)
  priority    Int          @default(100)
  countries   String[]
  services    String[]     // sms, otp, voice, whatsapp, email
  credentialsEncrypted String?
  healthStatus String      @default("UNKNOWN") // HEALTHY, DEGRADED, DOWN, UNKNOWN
  lastHealthCheckAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  attempts    MessageAttempt[]
}

model Message {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  service    String   // sms, otp, voice, whatsapp, email
  to         String
  status     String   @default("QUEUED") // QUEUED, SENT, DELIVERED, FAILED
  costAmount Decimal? @db.Decimal(14, 6)
  createdAt  DateTime @default(now())

  attempts   MessageAttempt[]
}

model MessageAttempt {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  success    Boolean
  errorCode  String?
  latencyMs  Int?
  createdAt  DateTime @default(now())
}

// ============ API KEYS ============

model ApiKey {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  label      String
  keyPrefix  String
  keyHash    String
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

// ============ SUPPORT ============

enum TicketStatus {
  OPEN
  PENDING
  ESCALATED
  RESOLVED
  CLOSED
}

model Ticket {
  id         String       @id @default(cuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id])
  subject    String
  status     TicketStatus @default(OPEN)
  priority   String       @default("normal")
  assignedAgentId String?
  assignedAgent   User?   @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  messages   TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType String  // customer, agent
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ BILLING ============

model Invoice {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(14, 4)
  currency   String   @default("USD")
  status     String   @default("PENDING") // PENDING, PAID, FAILED, VOID
  issuedAt   DateTime @default(now())
  paidAt     DateTime?
}

// ============ NEWS TICKER (with approval workflow) ============

enum NewsStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

model NewsPost {
  id          String     @id @default(cuid())
  titleEn     String
  titleAr     String?
  status      NewsStatus @default(DRAFT)
  authorId    String
  author      User       @relation("NewsAuthor", fields: [authorId], references: [id])
  approverId  String?
  approver    User?      @relation("NewsApprover", fields: [approverId], references: [id])
  rejectionReason String?
  priority    Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ============ CONTACT & SYSTEM SETTINGS ============

model ContactSetting {
  id          String  @id @default(cuid())
  department  String  @unique // support, admin, marketing, sales
  displayName String
  email       String?
  whatsapp    String? // E.164, e.g. +852XXXXXXXX
  visible     Boolean @default(true)
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  updatedAt DateTime @updatedAt
}

// ============ SALES CRM ============

enum DealStage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Company {
  id        String   @id @default(cuid())
  name      String
  website   String?
  country   String?
  createdAt DateTime @default(now())

  contacts  Contact[]
  deals     Deal[]
}

model Contact {
  id        String   @id @default(cuid())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  deals     Deal[]
  leads     Lead[]
}

model Lead {
  id          String   @id @default(cuid())
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  name        String
  email       String?
  source      String?  // google_ads, facebook, organic, referral, direct, sales
  ownerId     String?  // Sales user assigned
  status      String   @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  createdAt   DateTime @default(now())
}

model Deal {
  id          String    @id @default(cuid())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id])
  title       String
  stage       DealStage @default(NEW_LEAD)
  value       Decimal?  @db.Decimal(14, 2)
  ownerId     String?
  discountRequested Decimal? @db.Decimal(5, 2) // percent
  discountApproved  Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       CrmTask[]
}

model CrmTask {
  id        String   @id @default(cuid())
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  ownerId   String
  title     String
  dueAt     DateTime?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ MARKETING HUB ============

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RUNNING
  PAUSED
  STOPPED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  channel     String         // email, facebook, instagram, x, google_ads
  status      CampaignStatus @default(DRAFT)
  budget      Decimal?       @db.Decimal(14, 2)
  ownerId     String
  approverId  String?
  rejectionReason String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ============ MEETINGS ============

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  department  String?
  startTime   DateTime
  endTime     DateTime?
  meetingUrl  String?  // external provider URL if configured — never faked
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  createdById String
  createdAt   DateTime @default(now())

  participants MeetingParticipant[]
}

model MeetingParticipant {
  meetingId String
  userId    String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

// ============ INTERNAL CHAT ============

model InternalConversation {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())

  members  ConversationMember[]
  messages ChatMessage[]
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model ChatMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  createdAt      DateTime             @default(now())
}

// ============ DIAGNOSTICS ============

model DiagnosticRun {
  id         String   @id @default(cuid())
  triggeredById String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  summary    String?

  issues     DiagnosticIssue[]
}

model DiagnosticIssue {
  id           String   @id @default(cuid())
  runId        String
  run          DiagnosticRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  component    String   // database, api, provider:<id>, webhook, wallet, email, queue...
  severity     String   // info, warning, critical
  description  String
  autoFixable  Boolean  @default(false)
  status       String   @default("OPEN") // OPEN, FIX_STARTED, RESOLVED, IGNORED
  createdAt    DateTime @default(now())

  fixes        DiagnosticFix[]
}

model DiagnosticFix {
  id         String   @id @default(cuid())
  issueId    String
  issue      DiagnosticIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  appliedById String
  action     String
  result     String   @default("STARTED") // STARTED, COMPLETED, FAILED
  createdAt  DateTime @default(now())
}

// ============ AUDIT LOG ============

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String?
  resourceId String?
  ip         String?
  userAgent  String?
  result     String   @default("success")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
}

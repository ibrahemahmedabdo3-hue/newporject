{
  "name": "otpprovider",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next-auth": "4.24.7",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.17.0",
    "bcryptjs": "2.4.3",
    "zod": "3.23.8",
    "jsonwebtoken": "9.0.2",
    "nanoid": "5.0.7",
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "prisma": "5.17.0",
    "typescript": "5.5.4",
    "tsx": "4.16.2",
    "@types/node": "20.14.11",
    "@types/react": "18.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.6",
    "tailwindcss": "3.4.6",
    "postcss": "8.4.40",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5"
  }
